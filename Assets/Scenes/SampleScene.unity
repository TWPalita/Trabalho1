--- !u!114 &77100004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 77100001}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 65366be82d894784b9b87460b944e924, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AlarmManager
  initialMessageDelay: 0.35
  explorationDelay: 0.5
  diaryTitle: "DI\xC1RIO DE BORDO"
  storyMessage1: "Voc\xEA est\xE1 a bordo de uma nave espacial em uma longa jornada
    pela gal\xE1xia. Sua miss\xE3o \xE9 atravessar regi\xF5es desconhecidas do espa\xE7o
    e chegar ao seu pr\xF3ximo destino."
  storyMessage2: "Durante a viagem, a nave foi atacada por piratas espaciais. Embora
    voc\xEA tenha conseguido sobreviver, alguns sistemas foram danificados e o funcionamento
    da embarca\xE7\xE3o ficou comprometido."
  storyMessage3: "Ap\xF3s o incidente, voc\xEA desperta em seu quarto. \xC9 necess\xE1rio
    verificar o estado da nave antes de continuar a viagem. Explore os compartimentos
    e procure descobrir quais sistemas precisam ser restaurados."
  panelUnavailableTitle: "SISTEMA INDISPON\xCDVEL"
  panelUnavailableMessage: "O painel de controle est\xE1 sem energia e n\xE3o pode
    ativar o sistema de defesa. Os danos causados pelo ataque podem ter comprometido
    o fornecimento de energia da nave.\nVerifique o gerador auxiliar. Ele precisa
    de combust\xEDvel para voltar a funcionar e restabelecer a energia dos sistemas."
  panelBlockedTitle: ACESSO BLOQUEADO
  panelBlockedMessage: "O painel ainda est\xE1 sem energia. Abaste\xE7a o gerador
    auxiliar e restaure o fornecimento de energia antes de ativar o sistema de defesa."
  generatorEmptyTitle: GERADOR AUXILIAR
  generatorEmptyMessage: "Voc\xEA encontrou o gerador respons\xE1vel por fornecer
    energia aos sistemas auxiliares da nave. O equipamento est\xE1 sem combust\xEDvel
    e n\xE3o pode ser iniciado.\nEncontre o gal\xE3o de combust\xEDvel, leve-o at\xE9
    o gerador e abaste\xE7a o reservat\xF3rio."
  fuelCollectedTitle: "COMBUST\xCDVEL COLETADO"
  fuelCollectedMessage: "O gal\xE3o est\xE1 com voc\xEA. Leve-o at\xE9 o gerador
    auxiliar para abastecer o reservat\xF3rio e permitir que o equipamento volte
    a funcionar."
  refuelingCompleteTitle: "ABASTECIMENTO CONCLU\xCDDO"
  refuelingCompleteMessage: "O combust\xEDvel foi colocado no reservat\xF3rio. Agora,
    acione o bot\xE3o de igni\xE7\xE3o para reiniciar o gerador e restabelecer o
    fornecimento de energia."
  energyRestoredTitle: ENERGIA RESTAURADA
  energyRestoredMessage: "O gerador auxiliar voltou a funcionar e o fornecimento
    de energia foi restabelecido.\nOs sistemas da nave est\xE3o reiniciando. Entretanto,
    os sensores detectaram detritos espaciais em rota de colis\xE3o.\nRetorne ao
    painel de controle para ativar o sistema de defesa antes que os detritos atinjam
    a nave."
  alertDuration: 5
  alertTitle: ALERTA
  alertMessage: "Detritos espaciais detectados! A nave est\xE1 em rota de colis\xE3o.\nAtive
    o sistema de defesa imediatamente."
  objectiveTitle: OBJETIVO
  objectiveMessage: "Corra at\xE9 o painel de controle e ative o sistema de defesa."
  objectiveHint: "[ Aperte o bot\xE3o na mesa no final da nave ]"
  emergencyLightsController: {fileID: 77100006}
  objectiveCanvasObject: {fileID: 0}
  fixedObjectivePosition: {x: -3.5688727, y: 3.8999991, z: 1.97}
  fixedObjectiveRotation: {x: 0, y: 0, z: 0}
  showWorldSpaceNarrativeUI: 1
  narrativeCanvasObject: {fileID: 77300001}
  narrativeText: {fileID: 77300033}
  narrativeCanvasGroup: {fileID: 77300006}
  btnAvancar: {fileID: 77300054}
  btnVoltar: {fileID: 77300044}
  txtBtnAvancar: {fileID: 77300059}
  txtBtnVoltar: {fileID: 77300049}
  textoBotaoAvancar: "AVAN\xC7AR  >>"
  textoBotaoVoltar: <<  VOLTAR
  textoBotaoConcluir: EXPLORAR NAVE  >>
  textoBotaoAlerta: ENTENDIDO
